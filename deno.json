{
  "nodeModulesDir": "manual",
  "unstable": [
    "kv"
  ],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check main.ts client.ts routes islands components lib editor scripts pages i18n && sh scripts/greps.sh",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A --unstable-kv _fresh/server.js",
    "test": "deno test -A --unstable-kv"
  },
  "lint": {
    "exclude": [
      "static/",
      "design/"
    ],
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".data/",
    ".claude/",
    ".impeccable/"
  ],
  "fmt": {
    "exclude": [
      "static/",
      "design/",
      ".impeccable/",
      "content/"
    ],
    "lineWidth": 120
  },
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "preact": "npm:preact@10.29.8",
    "preact/hooks": "npm:preact@10.29.8/hooks",
    "markdown-it": "npm:markdown-it@14.3.3",
    "@types/markdown-it": "npm:@types/markdown-it@14.2.0",
    "sanitize-html": "npm:sanitize-html@2.18.1",
    "@types/sanitize-html": "npm:@types/sanitize-html@2.16.2",
    "prosemirror-model": "npm:prosemirror-model@1.25.12",
    "prosemirror-state": "npm:prosemirror-state@1.4.4",
    "prosemirror-view": "npm:prosemirror-view@1.42.8",
    "prosemirror-transform": "npm:prosemirror-transform@1.12.4",
    "prosemirror-markdown": "npm:prosemirror-markdown@1.13.9",
    "prosemirror-commands": "npm:prosemirror-commands@1.7.2",
    "prosemirror-keymap": "npm:prosemirror-keymap@1.2.3",
    "prosemirror-history": "npm:prosemirror-history@1.5.1",
    "prosemirror-inputrules": "npm:prosemirror-inputrules@1.5.1",
    "prosemirror-schema-list": "npm:prosemirror-schema-list@1.5.1",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "flowingkhaos",
    "app": "cerise"
  }
}
